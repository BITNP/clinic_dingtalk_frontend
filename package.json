{
  "name": "clinic-dingtalk-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Clinic appointment frontend for DingTalk",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:analyze": "vite build --mode analyze"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dingtalk-jsapi": "^3.2.2",
    "dompurify": "^3.2.3",
    "markdown-it": "^14.1.0",
    "pinia": "^2.3.1",
    "vant": "^4.9.15",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "terser": "^5.37.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
